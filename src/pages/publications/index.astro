---
import Layout from '../../layouts/Layout.astro';
import Publication from '../../components/Publication.astro';
import papers from '../../data/publications.json';
---
<Layout title="Publications — Hossein Shirali" description="Research papers by Hossein Shirali on computer vision, insect recognition, morphometrics, scientific imaging, and robotics.">
  <header class="page-intro"><p class="eyebrow">Research outputs</p><h1>Publications</h1><p>Computer vision, scientific imaging, and AI for biological research.</p><nav class="page-nav" aria-label="Publication groups"><a href="#published">Published articles</a><a href="#preprints">Preprints &amp; submissions</a><a href="https://scholar.google.com/citations?user=zXljf7gAAAAJ&amp;hl=en" target="_blank" rel="noopener noreferrer">Google Scholar ↗</a></nav></header>
  <section id="published" class="home-section" aria-labelledby="published-title"><h2 id="published-title">Published articles</h2><div class="publication-list">{papers.filter(p => p.status === 'Published').map(paper => <Publication paper={paper} />)}</div></section>
  <section id="preprints" class="home-section" aria-labelledby="preprints-title"><h2 id="preprints-title">Preprints &amp; Papers in Submission</h2><p class="section-description">Publication status is indicated for each work. Earlier preprints of published articles are linked with their journal version.</p><div class="publication-list">{papers.filter(p => p.status !== 'Published').map(paper => <Publication paper={paper} />)}</div></section>
</Layout>
