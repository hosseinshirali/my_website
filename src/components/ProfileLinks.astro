---
import profile from '../data/profile.json';
const { compact = false } = Astro.props;
---
<ul class:list={['profile-links', { compact }]} aria-label="Professional links">
  {profile.links.map(link => <li><a href={link.href}>{link.label}{link.label === 'CV' && <span class="link-note"> PDF</span>}</a></li>)}
</ul>
